# ===== LLM配置 =====
# 支持: dashscope / openai / gemini
DEFAULT_LLM_PROVIDER=dashscope
DEFAULT_LLM_MODEL=qwen-turbo-latest
DASHSCOPE_API_KEY=your_dashscope_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Embedding配置 =====
# 支持: dashscope / openai
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v1

# ===== 检索配置 =====
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true
RERANK_TOP_N=3

# ===== 应用配置 =====
APP_ROOT_PATH=

# ===== MinerU 简历 PDF 解析（官方 Agent 轻量 API，免 token，IP 限频） =====
# 云端/本地均无需部署 MinerU；以下为可选调优项，留空则用默认值
MINERU_API_BASE=https://mineru.net/api/v1/agent
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=false
MINERU_REQUEST_TIMEOUT=60
MINERU_POLL_TIMEOUT=300
MINERU_POLL_INTERVAL=3
# HTTP 自动重试（应对 CDN/API 偶发 TLS 中断 SSL EOF、连接超时、5xx/429）
MINERU_MAX_RETRIES=4
MINERU_RETRY_BACKOFF=1.0

# ===== 数据库配置 =====
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/table_name
REDIS_URL=redis://localhost:6380/0

# ===== 其他配置 =====
SECRET_KEY=
# HTTPS 正式域名下置 true，登录 cookie 才会带 Secure 标记；HTTP/IP 访问必须保持 false，否则登录态直接丢
COOKIE_SECURE=false
# 注册开关：默认 false（代码里也是 false）。注册后可上传项目文档、消耗 embedding 额度，
# 需要开放注册时才显式置 true
ALLOW_REGISTER=false
# 单份项目文档进入简历生成 prompt 的素材预算（token）。调大更完整但更慢更贵，调小则后面的章节被整节省略
RESUME_MATERIAL_MAX_TOKENS=1500
MAIL_USERNAME=<your_email_username>
MAIL_PASSWORD=<your_email_password>
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_FROM=noreply@fastapiblog.com